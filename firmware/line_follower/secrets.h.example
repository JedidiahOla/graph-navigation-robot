// secrets.h.example - copy to secrets.h and fill in.
//
// secrets.h is in .gitignore. The original sketch had the network credentials
// hardcoded in the main source file, which is how they end up in a public
// repository.

#ifndef SECRETS_H
#define SECRETS_H

// Access point the robot joins. The CC3100 supports WPA2 Personal.
#define WIFI_SSID "your-network"
#define WIFI_PASSWORD "your-password"

// Waypoint server supplied by the module.
#define SERVER_HOST "0.0.0.0"
#define SERVER_PORT 8081

// Per team endpoint. The token at the end identified the robot to the server.
#define SERVER_ARRIVAL_PATH "/api/arrived/your-team-token"

#endif  // SECRETS_H
